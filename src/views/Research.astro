---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import ResearchCard from '../components/ResearchCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Pager from '../components/Pager.astro';
import { ui, routes, type Lang } from '../lib/i18n';
import { getResearchLines, getProjects } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const lines = await getResearchLines();
const projects = await getProjects();
const lead = lang === 'es'
  ? 'Física de los cinturones de radiación, ondas ULF, turbulencia magnetosférica, acoplamiento viento solar-magnetosfera y predicción de clima espacial con machine learning.'
  : 'Radiation belt physics, ULF waves, magnetospheric turbulence, solar wind-magnetosphere coupling, and machine-learning space weather prediction.';
---
<Layout lang={lang} title={t.nav.research} route="research" description={lead}>
  <PageHeader eyebrow={t.research.eyebrow} title={t.nav.research} lead={lead} back={{ href: `${routes.home[lang]}#research`, label: t.backHome }} />

  <section class="band">
    <div class="wrap">
      <SectionHead title={t.research.title} />
      <div class="grid grid-2">
        {lines.map((l) => <ResearchCard line={l} lang={lang} variant="full" />)}
      </div>
    </div>
  </section>

  <section class="band band-alt" id="projects">
    <div class="wrap">
      <SectionHead eyebrow={t.projects.eyebrow} title={t.projects.title} />
      <div class="grid grid-3">
        {projects.map((p) => <ProjectCard project={p} lang={lang} />)}
      </div>
    </div>
  </section>

  <Pager lang={lang} current="research" section="research" />
</Layout>
