---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import Pager from '../components/Pager.astro';
import { ui, routes, pick, type Lang } from '../lib/i18n';
import { getInfrastructure } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const es = lang === 'es';
const items = await getInfrastructure();
const data = es ? [
  { title: 'Satélites', text: 'Van Allen Probes (MagEIS, REPT, EMFISIS, EFW) · THEMIS (SPEDAS) · GOES · OMNI · Parker Solar Probe' },
  { title: 'Redes en tierra', text: 'Magnetómetros SAMBA · MACCS · THEMIS GBO · CARISMA · radares SuperDARN' },
  { title: 'Herramientas', text: 'Python (NumPy, SciPy, pandas, Matplotlib, SpacePy) · TensorFlow/Keras · PyTorch · scikit-learn' },
] : [
  { title: 'Satellites', text: 'Van Allen Probes (MagEIS, REPT, EMFISIS, EFW) · THEMIS (SPEDAS) · GOES · OMNI · Parker Solar Probe' },
  { title: 'Ground networks', text: 'SAMBA · MACCS · THEMIS GBO · CARISMA magnetometers · SuperDARN radars' },
  { title: 'Tools', text: 'Python (NumPy, SciPy, pandas, Matplotlib, SpacePy) · TensorFlow/Keras · PyTorch · scikit-learn' },
];
const lead = es ? 'Cómputo, instrumentación y datos que sostienen nuestra investigación en heliofísica y clima espacial.' : 'The computing, instrumentation, and data behind our heliophysics and space weather research.';
---
<Layout lang={lang} title={t.nav.infrastructure} route="infrastructure" description={lead}>
  <PageHeader eyebrow={t.infra.eyebrow} title={t.infra.title} lead={lead} back={{ href: `${routes.home[lang]}#infrastructure`, label: t.backHome }} />
  <section class="band">
    <div class="wrap">
      <div class="grid grid-3">
        {items.map((i) => (
          <article class="card"><div class="card-body">
            <h3>{pick(i, 'title', lang)}</h3>
            <p>{pick(i, 'text', lang)}</p>
            {i.link && <p class="meta"><a href={i.link} target="_blank" rel="noopener">{pick(i, 'linkLabel', lang) ?? i.link}</a></p>}
          </div></article>
        ))}
      </div>
    </div>
  </section>
  <section class="band band-alt">
    <div class="wrap">
      <SectionHead title={es ? 'Datos que utilizamos' : 'Data we use'} />
      <div class="dl">
        {data.map((d) => <div><h3>{d.title}</h3><p>{d.text}</p></div>)}
      </div>
    </div>
  </section>
  <Pager lang={lang} current="infrastructure" section="infrastructure" />
</Layout>
