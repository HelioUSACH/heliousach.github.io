---
// The home page is the whole site in one scroll. Each section is a summary of
// a detail page ("See full page") and is also a nav target (id + data-section).
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import ResearchCard from '../components/ResearchCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Person from '../components/Person.astro';
import PubList from '../components/PubList.astro';
import NewsCard from '../components/NewsCard.astro';
import { ui, routes, pick, type Lang } from '../lib/i18n';
import { site } from '../lib/site';
import { getTeam, getPublications, getResearchLines, getProjects, getNews, getInfrastructure } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const full = (href: string) => ({ href, label: t.fullPage });

const lines = await getResearchLines();
const featured = (await getProjects()).filter((p) => p.featured != null).sort((a, b) => a.featured! - b.featured!);
const news = (await getNews(lang)).slice(0, 3);
const people = (await getTeam()).filter((p) => ['investigadores', 'postdoc', 'estudiantes'].includes(p.data.group));
const pubs = (await getPublications()).slice(0, 5);
const infra = await getInfrastructure();
---
<Layout lang={lang} title={t.nav.home} route="home">
  <section class="hero">
    <img src={site.hero.image} alt={pick(site.hero, 'alt', lang)} fetchpriority="high" />
    <div class="wrap">
      <p class="eyebrow">Universidad de Santiago de Chile — {lang === 'es' ? 'Departamento de Física' : 'Department of Physics'}</p>
      <h1 class="display">{pick(site, 'tagline', lang)}</h1>
      <p>{pick(site.hero, 'text', lang)}</p>
      <p class="credit">{t.credit}: {site.hero.credit}</p>
    </div>
  </section>

  <section class="band" id="research" data-section="research">
    <div class="wrap">
      <SectionHead eyebrow={t.research.eyebrow} title={t.research.title} more={full(routes.research[lang])} />
      <div class="grid grid-2 reveal">
        {lines.map((l) => <ResearchCard line={l} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="band band-alt" id="projects" data-section="research">
    <div class="wrap">
      <SectionHead eyebrow={t.projects.eyebrow} title={t.projects.title} more={full(`${routes.research[lang]}#projects`)} />
      <div class="stack reveal">
        {featured.map((p) => <ProjectCard project={p} lang={lang} variant="feature" />)}
      </div>
    </div>
  </section>

  {news.length > 0 && (
    <section class="band" id="news" data-section="news">
      <div class="wrap">
        <SectionHead eyebrow={t.news.eyebrow} title={t.news.latest} more={full(routes.news[lang])} />
        <div class="grid grid-3 reveal">
          {news.map((n) => <NewsCard item={n} lang={lang} />)}
        </div>
      </div>
    </section>
  )}

  <section class="band band-alt" id="team" data-section="team">
    <div class="wrap">
      <SectionHead eyebrow={t.team.eyebrow} title={t.team.title} more={full(routes.team[lang])} />
      <div class="grid grid-4 reveal">
        {people.map((p) => <Person person={p.data} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="band" id="publications" data-section="publications">
    <div class="wrap">
      <SectionHead eyebrow={t.pubs.eyebrow} title={t.pubs.title} more={full(routes.publications[lang])} />
      <div class="reveal"><PubList pubs={pubs} lang={lang} /></div>
    </div>
  </section>

  <section class="band band-alt" id="infrastructure" data-section="infrastructure">
    <div class="wrap">
      <SectionHead eyebrow={t.infra.eyebrow} title={t.infra.title} more={full(routes.infrastructure[lang])} />
      <div class="grid grid-3 reveal">
        {infra.map((i) => (
          <article class="card"><div class="card-body">
            <h3>{pick(i, 'title', lang)}</h3>
            <p>{pick(i, 'text', lang)}</p>
          </div></article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" id="contact" data-section="contact">
    <div class="wrap">
      <SectionHead eyebrow={t.nav.contact} title={t.contact.title} />
      <div class="contact-grid">
        <div>
          <p>{pick(site.openCall, 'text', lang)}</p>
          <p>{t.footer.body}</p>
        </div>
        <div class="contact-card">
          <p class="name">{site.contact.name}</p>
          <p class="role">{pick(site.contact, 'role', lang)}</p>
          <p class="muted small">{pick(site.contact, 'address', lang)}</p>
          <a class="email" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          <div class="social">
            {site.social.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.label}</a>)}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
