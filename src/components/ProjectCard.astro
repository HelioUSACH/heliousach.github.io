---
// A project/grant. "feature" = image + text side by side; "compact" = text card.
import { pick, inlineMd, type Lang } from '../lib/i18n';
interface Props { project: Record<string, any>; lang: Lang; variant?: 'feature' | 'compact' }
const { project: p, lang, variant = 'compact' } = Astro.props;
const tags: string[] = pick(p, 'tags', lang) ?? [];
---
{variant === 'feature' && p.image ? (
  <article class="card project-feature">
    <div class="frame"><img src={p.image} alt={pick(p, 'imageAlt', lang) ?? ''} loading="lazy" /></div>
    <div class="card-body">
      <p class="eyebrow">{pick(p, 'grant', lang)} · {p.funder}</p>
      <h3>{pick(p, 'title', lang)}</h3>
      <p>{pick(p, 'summary', lang)}</p>
      {tags.length > 0 && <ul class="tags">{tags.map((t) => <li class="tag">{t}</li>)}</ul>}
      <p class="meta" set:html={`${inlineMd(pick(p, 'people', lang))} · ${p.years}`} />
    </div>
  </article>
) : (
  <article class="card">
    <div class="card-body">
      <p class="eyebrow">{pick(p, 'grant', lang)} · {p.funder}</p>
      <h3>{pick(p, 'title', lang)}</h3>
      <p set:html={inlineMd(pick(p, 'people', lang))} />
      <p class="meta">{p.years}</p>
    </div>
  </article>
)}
