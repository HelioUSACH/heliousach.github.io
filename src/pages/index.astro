        </span>
      </button>
    </div>
    <a class="hp-team-more" href="/equipo">Ver equipo completo →</a>
  </div>
</section>

<section class="hp-publications" id="publicaciones">
  <div class="hp-wrap">
    <div class="hp-section-head hp-reveal">
      <p class="hp-eyebrow">Publicaciones</p>
      <h2>Publicaciones recientes</h2>
