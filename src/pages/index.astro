---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TeamCard from '../components/TeamCard.astro';
import PublicationItem from '../components/PublicationItem.astro';
import ResearchLineCard from '../components/ResearchLineCard.astro';
import ProjectCard from '../components/ProjectCard.astro';

const lang = 'es';
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const homeTeam = team.filter((t) => t.data.status === 'pi' || t.data.status === 'current-student');
const publications = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const homePubs = publications.slice(0, 5);
const researchLines = (await getCollection('researchLines')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = (await getCollection('projects'))
  .filter((p) => p.data.featured != null)
  .sort((a, b) => a.data.featured - b.data.featured);
---

<Layout title="Inicio" description="Grupo de investigación en Heliofísica y Clima Espacial de la Universidad de Santiago de Chile. Cinturones de radiación, ondas ULF, turbulencia magnetosférica y predicción de clima espacial." variant="home">

<section class="hp-hero" id="inicio">
  <img src="/images/earth-hero.jpg" alt="Vista del sistema solar desde la misión Parker Solar Probe" loading="eager" />
  <div class="hp-hero-scrim"></div>
  <div class="hp-hero-content">
    <p class="hp-eyebrow">Universidad de Santiago de Chile — Departamento de Física</p>
    <h1>Heliofísica y Clima Espacial</h1>
    <p class="hp-hero-sub">Estudiamos la magnetosfera terrestre, los cinturones de radiación y el acoplamiento viento solar-magnetosfera utilizando datos satelitales y observaciones desde tierra. Nuestro grupo desarrolla herramientas de machine learning para la predicción de clima espacial y colabora en la primera plataforma nacional chilena de monitoreo de clima espacial.</p>
  </div>
  <p class="hp-hero-credit">Crédito: NASA/PSPL/PIA23789</p>
</section>

<section id="investigacion">
  <div class="hp-wrap">
    <div class="hp-section-head hp-reveal">
      <p class="hp-eyebrow">Investigación</p>
      <h2>Nuestras líneas de investigación</h2>
    </div>
    <div class="hp-research-grid hp-reveal">
      {researchLines.map((r) => <ResearchLineCard data={r.data} lang={lang} variant="mini" />)}
    </div>
    <a class="hp-more" href="/investigacion">Ver líneas de investigación y proyectos →</a>
  </div>
</section>

<div class="hp-section-alt">
<section id="proyectos">
  <div class="hp-wrap">
    <div class="hp-section-head hp-reveal">
      <p class="hp-eyebrow">Proyectos activos</p>
      <h2>Proyectos actuales</h2>
    </div>
    <div class="hp-project-list hp-reveal">
      {featuredProjects.map((p) => <ProjectCard data={p.data} lang={lang} variant="mini" />)}
    </div>
    <a class="hp-more" href="/investigacion#proyectos">Ver todos los proyectos activos →</a>
  </div>
</section>
</div>

<section id="equipo">
  <div class="hp-wrap">
    <div class="hp-section-head hp-reveal">
      <p class="hp-eyebrow">Equipo</p>
      <h2>Nuestro equipo</h2>
    </div>
    <div class="hp-team-grid hp-reveal">
      {homeTeam.map((p) => <TeamCard data={p.data} lang={lang} variant="mini" />)}
    </div>
    <a class="hp-more" href="/equipo">Ver equipo completo →</a>
  </div>
</section>

<div class="hp-section-alt">
<section id="publicaciones">
  <div class="hp-wrap">
    <div class="hp-section-head hp-reveal">
      <p class="hp-eyebrow">Publicaciones</p>
      <h2>Publicaciones recientes</h2>
    </div>
    <ul class="hp-pub-list hp-reveal">
      {homePubs.map((p) => <PublicationItem data={p.data} variant="mini" />)}
    </ul>
    <a class="hp-more" href="/investigacion#publicaciones">Ver todas las publicaciones →</a>
  </div>
</section>
</div>

<section id="laboratorio">
  <div class="hp-wrap">
    <div class="hp-section-head hp-reveal">
      <p class="hp-eyebrow">Laboratorios</p>
      <h2>Nuestros laboratorios</h2>
    </div>
    <div class="hp-reveal">
      <p class="hp-hero-sub" style="color:var(--ink-soft);max-width:65ch">
        El grupo opera dos laboratorios de investigación. El <strong>Laboratorio de Instrumentación Espacial</strong> mantiene redes de magnetómetros en tierra (cadena SAMBA) y apoya campañas de campo. El <strong>Laboratorio de Clima Espacial</strong> desarrolla sistemas de monitoreo en tiempo real y predicción basada en machine learning para perturbaciones geomagnéticas y dinámica de electrones relativistas.
      </p>
    </div>
    <a class="hp-more" href="/laboratorio">Ver laboratorios y fuentes de datos →</a>
  </div>
</section>

<section class="contact-section" id="contacto" aria-label="Contacto">
  <div class="hp-wrap">
    <div class="hp-section-head hp-reveal">
      <p class="hp-eyebrow">Contacto</p>
      <h2>Convocatoria abierta</h2>
      <p>Buscamos estudiantes de magíster y pregrado para trabajar en dinámica de electrones relativistas, predicción de tormentas geomagnéticas con deep learning, modelamiento de GIC, procesamiento de datos satelitales (Van Allen Probes, THEMIS, GOES) y turbulencia magnetosférica. Si eres estudiante de física, astrofísica o carreras afines, escríbenos a <a href="mailto:victor.pinto@usach.cl">victor.pinto@usach.cl</a></p>
    </div>
  </div>
</section>

</Layout>
