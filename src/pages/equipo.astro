---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TeamCard from '../components/TeamCard.astro';

const lang = 'es';
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const pis = team.filter((t) => t.data.status === 'pi');
const students = team.filter((t) => t.data.status === 'current-student');
const formerMembers = team.filter((t) => t.data.status === 'former-member');
const collaborators = team.filter((t) => t.data.status === 'collaborator');
---

<Layout title="Equipo" description="Investigadores y estudiantes del grupo Heliofísica y Clima Espacial USACH.">

<section>
  <span class="section-title">Equipo</span>
  <h1>Nuestro equipo</h1>
  <p class="lead">El grupo Heliofísica y Clima Espacial es co-dirigido por el Dr. Victor A. Pinto y la Dra. Marina Stepanova, Departamento de Física, Universidad de Santiago de Chile.</p>
</section>

<section class="section">
  <span class="section-title">Investigadores</span>
  <div class="grid" style="grid-template-columns:1fr 1fr;gap:1rem">
    {pis.map((p) => <TeamCard data={p.data} lang={lang} />)}
  </div>
</section>

<section class="section">
  <span class="section-title">Estudiantes</span>
  <div class="grid">
    {students.map((s) => <TeamCard data={s.data} lang={lang} />)}
  </div>
</section>

<section class="section">
  <span class="section-title">Colaboradores</span>
  <div class="grid">
    {collaborators.map((c) => <TeamCard data={c.data} lang={lang} />)}
  </div>
</section>

<section class="section">
  <span class="section-title">Ex-Miembros</span>
  <div class="grid">
    {formerMembers.map((m) => <TeamCard data={m.data} lang={lang} />)}
  </div>
</section>

<section class="section">
  <span class="section-title">Convocatoria abierta</span>
  <div class="card" style="border-color:var(--border-accent)">
    <p>Buscamos estudiantes de magíster y pregrado para proyectos de investigación:</p>
    <ul style="margin:1rem 0 0 1.5rem">
      <li>Dinámica de electrones relativistas en el cinturón externo</li>
      <li>Predicción de tormentas geomagnéticas con Deep Learning</li>
      <li>Corrientes inducidas geomagnéticamente (GIC)</li>
      <li>Procesamiento de datos satelitales (Van Allen Probes, THEMIS, GOES)</li>
      <li>Turbulencia y balance de presión en la magnetosfera</li>
      <li>Acoplamiento viento solar — magnetosfera</li>
    </ul>
    <p style="margin-top:1rem">Si eres estudiante de ingeniería física, astrofísica o carreras afines, escríbenos a <a href="mailto:victor.pinto@usach.cl">victor.pinto@usach.cl</a></p>
  </div>
</section>

</Layout>
