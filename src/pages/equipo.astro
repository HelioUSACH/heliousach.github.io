---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Equipo" description="Equipo de investigadores y estudiantes del grupo HelioFísica y Clima Espacial USACH.">

<section>
  <span class="section-title">Equipo</span>
  <h1>Nuestro equipo</h1>
  <p class="lead">Investigadores, estudiantes de magíster y pregrado del grupo HelioFísica y Clima Espacial USACH.</p>
</section>

<section class="section">
  <span class="section-title">Investigador Principal</span>
  <div class="card">
    <h3>Dr. Victor A. Pinto Abarzúa</h3>
    <p><strong>Profesor Asistente</strong> · Departamento de Física, USACH</p>
    <p>Ph.D. en Ciencias Atmosféricas y Oceánicas (Física Espacial), UCLA 2019. Postdoctorado en UNH (2020-2022). Investigador en cinturones de radiación, ondas ULF, clima espacial y machine learning.</p>
    <div style="margin-top:0.75rem">
      <a href="https://victorapinto.com" target="_blank" rel="noopener">Sitio personal</a> ·
      <a href="https://scholar.google.com/citations?user=nEqGWqoAAAAJ" target="_blank">Google Scholar</a> ·
      <a href="https://orcid.org/0000-0003-1210-167X" target="_blank">ORCID</a>
    </div>
  </div>
</section>

<section class="section">
  <span class="section-title">Co-Investigadora</span>
  <div class="card">
    <h3>Dra. Marina Stepanova</h3>
    <p><strong>Profesora Asociada</strong> · Departamento de Física, USACH</p>
    <p>Colaboradora en turbulencia magnetosférica, dinámica de electrones relativistas y plataforma de clima espacial.</p>
  </div>
</section>

<section class="section">
  <span class="section-title">Estudiantes de magíster</span>
  <div class="grid">
    <div class="card">
      <h3>Ana María Inostroza</h3>
      <p>Magíster en Ciencias Físicas, USACH</p>
      <p class="meta">Dinámica del cinturón de radiación externo y fenómenos aurorales</p>
    </div>
    <div class="card">
      <h3>Bea Zenteno-Quinteros</h3>
      <p>Magíster en Ciencias Físicas, USACH</p>
      <p class="meta">Procesos de pérdida de electrones relativistas por ondas electromagnéticas</p>
    </div>
    <div class="card">
      <h3>Dafhne Muñoz Reyes</h3>
      <p>Ingeniería en Astrofísica, USACH</p>
      <p class="meta">Modelo ML para ubicación de la plasmapausa (Van Allen Probes)</p>
    </div>
    <div class="card">
      <h3>Camila Peña Cifuentes</h3>
      <p>Ingeniería Física, USACH</p>
      <p class="meta">Predicción de flujo de electrones relativistas con Deep Learning</p>
    </div>
  </div>
</section>

<section class="section">
  <span class="section-title">Graduados recientes</span>
  <div class="grid">
    <div class="card">
      <h3>Yulissa Espitia</h3>
      <p>Magíster en Ciencias Físicas, USACH (2025)</p>
      <p class="meta">Evolución radial de electrones ultrarelativistas durante eventos de aumento</p>
    </div>
    <div class="card">
      <h3>Carlos Castillo</h3>
      <p>Magíster en Ciencias Físicas, USACH (2025)</p>
      <p class="meta">Caracterización del contenido total de electrones a altas latitudes</p>
    </div>
    <div class="card">
      <h3>Christopher Lara</h3>
      <p>Magíster en Ciencias Físicas, UdeChile (2024)</p>
      <p class="meta">Relación entre la aparición de ondas ULF y cambios en flujos de electrones relativistas</p>
    </div>
    <div class="card">
      <h3>Yerko Jelcic Iturra</h3>
      <p>Ingeniería en Astrofísica, USACH (2024)</p>
