---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import ResearchLineCard from '../components/ResearchLineCard.astro';
import ProjectCard from '../components/ProjectCard.astro';

const lang = 'es';
const publications = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const researchLines = (await getCollection('researchLines')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Investigación" description="Líneas de investigación, proyectos activos y publicaciones del grupo Heliofísica y Clima Espacial USACH.">

<section>
  <span class="section-title">Investigación</span>
  <h1>Investigación</h1>
  <p class="lead">Física de los cinturones de radiación, ondas ULF, turbulencia magnetosférica, acoplamiento viento solar-magnetosfera y predicción de clima espacial con machine learning.</p>
</section>

<section class="section">
  <span class="section-title">Líneas de investigación</span>

  {researchLines.map((r) => <ResearchLineCard data={r.data} lang={lang} variant="full" />)}
</section>

<div class="divider"></div>

<section class="section" id="proyectos">
  <span class="section-title">Proyectos activos</span>
  <div class="grid">
    {projects.map((p) => <ProjectCard data={p.data} lang={lang} variant="full" />)}
  </div>
</section>

<div class="divider"></div>

<section class="section" id="publicaciones">
  <span class="section-title">Publicaciones recientes</span>
  <p class="meta">Lista completa: <a href="https://scholar.google.com/citations?user=nEqGWqoAAAAJ" target="_blank">Google Scholar</a> · <a href="https://orcid.org/0000-0003-1210-167X" target="_blank">ORCID</a></p>

  {publications.map((p) => <PublicationItem data={p.data} variant="full" />)}
</section>

</Layout>
