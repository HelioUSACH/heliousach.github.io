---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import ResearchLineCard from '../../components/ResearchLineCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const lang = 'en';
const publications = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const researchLines = (await getCollection('researchLines')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Research" description="Research lines, active projects and publications of the HelioFísica and Space Weather USACH group.">

<section>
  <span class="section-title">Research</span>
  <h1>Research</h1>
  <p class="lead">Van Allen radiation belt physics, ULF waves, magnetospheric turbulence, solar wind—magnetosphere coupling, and space weather prediction with machine learning.</p>
</section>

<section class="section">
  <span class="section-title">Research lines</span>

  {researchLines.map((r) => <ResearchLineCard data={r.data} lang={lang} variant="full" />)}
</section>

<div class="divider"></div>

<section class="section" id="proyectos">
  <span class="section-title">Active projects</span>
  <div class="grid">
    {projects.map((p) => <ProjectCard data={p.data} lang={lang} variant="full" />)}
  </div>
</section>

<div class="divider"></div>

<section class="section" id="publicaciones">
  <span class="section-title">Selected recent publications</span>
  <p class="meta">Full list: <a href="https://scholar.google.com/citations?user=nEqGWqoAAAAJ" target="_blank">Google Scholar</a> · <a href="https://orcid.org/0000-0003-1210-167X" target="_blank">ORCID</a></p>

  {publications.map((p) => <PublicationItem data={p.data} variant="full" />)}
</section>

</Layout>
