---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TeamCard from '../../components/TeamCard.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import ResearchLineCard from '../../components/ResearchLineCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const lang = 'en';
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const homeTeam = team.filter((t) => ['pi', 'postdoc', 'current-student'].includes(t.data.status));
const publications = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const homePubs = publications.slice(0, 5);
const researchLines = (await getCollection('researchLines')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = (await getCollection('projects'))
  .filter((p) => p.data.featured != null)
  .sort((a, b) => a.data.featured - b.data.featured);
---

<Layout title="Home" description="Heliophysics and Space Weather research group at Universidad de Santiago de Chile. Radiation belts, ULF waves, magnetospheric turbulence, and space weather prediction." variant="home">

<section class="hp-hero" id="inicio">
  <img src="/images/eso1912u-la-silla-eclipse.jpg" alt="Solar corona during the 2 July 2019 total solar eclipse, observed from La Silla, Chile" loading="eager" />
  <div class="hp-hero-scrim"></div>
  <div class="hp-hero-content">
    <p class="hp-eyebrow">Universidad de Santiago de Chile — Department of Physics</p>
    <h1>Heliophysics and Space Weather</h1>
    <p class="hp-hero-sub">We study the Earth's magnetosphere, radiation belts, and solar wind coupling using satellite data and ground-based observations. Our group develops machine learning tools for space weather prediction and contributes to developing a pilot space weather monitoring platform for Chile.</p>
  </div>
  <p class="hp-hero-credit">Credit: ESA/CESAR</p>
</section>

<section id="investigacion">
  <div class="hp-wrap">
    <div class="hp-section-head hp-reveal">
      <p class="hp-eyebrow">Research</p>
      <h2>Our research lines</h2>
    </div>
    <div class="hp-research-grid hp-reveal">
      {researchLines.map((r) => <ResearchLineCard data={r.data} lang={lang} variant="mini" />)}
    </div>
    <a class="hp-more" href="/en/research">See all research lines and projects →</a>
  </div>
</section>

<div class="hp-section-alt">
<section id="proyectos">
  <div class="hp-wrap">
    <div class="hp-section-head hp-reveal">
      <p class="hp-eyebrow">Active grants</p>
      <h2>Current projects</h2>
    </div>
    <div class="hp-project-list hp-reveal">
      {featuredProjects.map((p) => <ProjectCard data={p.data} lang={lang} variant="mini" />)}
    </div>
    <a class="hp-more" href="/en/research#proyectos">See all active grants →</a>
  </div>
</section>
</div>

<section id="equipo">
  <div class="hp-wrap">
    <div class="hp-section-head hp-reveal">
      <p class="hp-eyebrow">Team</p>
      <h2>Our team</h2>
    </div>
    <div class="hp-team-grid hp-reveal">
      {homeTeam.map((p) => <TeamCard data={p.data} lang={lang} variant="mini" />)}
    </div>
    <a class="hp-more" href="/en/team">See full team →</a>
  </div>
</section>

<div class="hp-section-alt">
<section id="publicaciones">
  <div class="hp-wrap">
    <div class="hp-section-head hp-reveal">
      <p class="hp-eyebrow">Publications</p>
      <h2>Recent publications</h2>
    </div>
    <ul class="hp-pub-list hp-reveal">
      {homePubs.map((p) => <PublicationItem data={p.data} variant="mini" />)}
    </ul>
    <a class="hp-more" href="/en/research#publicaciones">See all publications →</a>
  </div>
</section>
</div>

<section id="laboratorio">
  <div class="hp-wrap">
    <div class="hp-section-head hp-reveal">
      <p class="hp-eyebrow">Infrastructure</p>
      <h2>Infrastructure and data</h2>
    </div>
    <div class="hp-reveal">
      <p class="hp-hero-sub" style="color:var(--ink-soft);max-width:65ch">
        The group runs a <strong>high-performance computing cluster</strong> (FONDEQUIP) for data science and modeling, contributes to the FONDEF <strong>pilot space weather platform</strong> led by Universidad Adventista de Chile, and evaluates <strong>magnetometers</strong> for geomagnetic monitoring. We work with satellite data (Van Allen Probes, THEMIS, GOES, OMNI) and ground magnetometer networks.
      </p>
    </div>
    <a class="hp-more" href="/en/lab">See infrastructure and data sources →</a>
  </div>
</section>

<section class="contact-section" id="contacto" aria-label="Contact">
  <div class="hp-wrap">
    <div class="hp-section-head hp-reveal">
      <p class="hp-eyebrow">Contact</p>
      <h2>Open positions</h2>
      <p>We are looking for master's and undergraduate students to work on relativistic electron dynamics, geomagnetic storm prediction with deep learning, GIC modeling, satellite data processing (Van Allen Probes, THEMIS, GOES), and magnetospheric turbulence. If you are a physics, astrophysics, or related student, email us at <a href="mailto:victor.pinto@usach.cl">victor.pinto@usach.cl</a></p>
    </div>
  </div>
</section>

</Layout>
