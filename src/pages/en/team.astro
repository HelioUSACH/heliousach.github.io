---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TeamCard from '../../components/TeamCard.astro';

const lang = 'en';
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const pis = team.filter((t) => t.data.status === 'pi');
const postdocs = team.filter((t) => t.data.status === 'postdoc');
const students = team.filter((t) => t.data.status === 'current-student');
const formerMembers = team.filter((t) => t.data.status === 'former-member');
const collaborators = team.filter((t) => t.data.status === 'collaborator');
---

<Layout title="Team" description="Researchers and students of the HelioFísica and Space Weather USACH group.">

<section>
  <span class="section-title">Team</span>
  <h1>Our team</h1>
  <p class="lead">The HelioFísica and Space Weather group is co-led by Dr. Victor A. Pinto and Prof. Marina Stepanova, Department of Physics, Universidad de Santiago de Chile.</p>
</section>

<section class="section">
  <span class="section-title">Researchers</span>
  <div class="grid-2">
    {pis.map((p) => <TeamCard data={p.data} lang={lang} />)}
  </div>
</section>

<section class="section">
  <span class="section-title">Postdoctoral researchers</span>
  <div class="grid">
    {postdocs.map((p) => <TeamCard data={p.data} lang={lang} />)}
  </div>
</section>

<section class="section">
  <span class="section-title">Students</span>
  <div class="grid">
    {students.map((s) => <TeamCard data={s.data} lang={lang} />)}
  </div>
</section>

<section class="section">
  <span class="section-title">Collaborators</span>
  <div class="grid">
    {collaborators.map((c) => <TeamCard data={c.data} lang={lang} />)}
  </div>
</section>

<section class="section">
  <span class="section-title">Former members</span>
  <div class="grid">
    {formerMembers.map((m) => <TeamCard data={m.data} lang={lang} />)}
  </div>
</section>

<section class="section">
  <span class="section-title">Open positions</span>
  <div class="card card-accent">
    <p>We are looking for master's and undergraduate students for research projects:</p>
    <ul class="card-list">
      <li>Relativistic electron dynamics in the outer radiation belt</li>
      <li>Geomagnetic storm prediction with Deep Learning</li>
      <li>Geomagnetically induced currents (GIC)</li>
      <li>Satellite data processing (Van Allen Probes, THEMIS, GOES)</li>
      <li>Turbulence and pressure balance in the magnetosphere</li>
      <li>Solar wind — magnetosphere coupling</li>
    </ul>
    <p class="card-note">If you are a physics, astrophysics, or related science student, email us at <a href="mailto:victor.pinto@usach.cl">victor.pinto@usach.cl</a></p>
  </div>
</section>

</Layout>
