---
// Page shell: <head>, header with navigation, footer. Every page uses it.
import '../styles/global.css';
import { ui, routes, pick, navOrder, sections, type Lang, type RouteKey, type NavKey } from '../lib/i18n';
import { site } from '../lib/site';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Page identity: 'home' or a detail page. Drives the ES/EN switch and the active nav item. */
  route?: RouteKey;
  /** Explicit ES/EN counterpart paths (for pages outside `routes`, e.g. a news item). */
  alternates?: { es: string; en: string };
  image?: string;
}

const { lang, title, description, route, alternates, image } = Astro.props;
const t = ui[lang];
const base = 'https://heliousach.github.io';
const alt = alternates ?? (route ? { es: routes[route].es, en: routes[route].en } : { es: '/', en: '/en/' });
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const pageTitle = route === 'home' ? `${site.name} — ${pick(site, 'tagline', lang)}` : `${title} | ${site.name}`;
const desc = description ?? pick(site, 'description', lang);
const ogImage = `${base}${image ?? site.hero.image}`;
const isHome = route === 'home';
// One-page scroller: nav items are home-page sections. On detail pages they
// point back to the home section; the section the page expands is marked active.
const navHref = (k: NavKey) => `${isHome ? '' : routes.home[lang]}#${sections.find((s) => s.nav === k)!.id}`;
const activeNav: NavKey | undefined = route && route !== 'home' ? (route as NavKey) : undefined;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ResearchOrganization',
  name: 'Heliofísica y Clima Espacial USACH',
  url: base,
  logo: `${base}/images/brand/emblem.png`,
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Universidad de Santiago de Chile (USACH)' },
  email: `mailto:${site.contact.email}`,
  sameAs: site.social.map((s) => s.url),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var theme = 'day';
        try { theme = localStorage.getItem('theme') || 'day'; } catch (e) {}
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.classList.add('js');
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={`${base}${here}`} />
    <link rel="alternate" hreflang="es" href={`${base}${alt.es}`} />
    <link rel="alternate" hreflang="en" href={`${base}${alt.en}`} />
    <link rel="alternate" hreflang="x-default" href={`${base}${alt.es}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600&family=Roboto:wght@400;500&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={`${base}${here}`} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_CL'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={routes.home[lang]}>
          <img class="emblem-day" src="/images/brand/emblem.png" alt="" width="40" height="40" />
          <img class="emblem-night" src="/images/brand/emblem-white.png" alt="" width="40" height="40" />
          <span class="brand-text">
            <small>{lang === 'es' ? 'Grupo de investigación' : 'Research group'}</small>
            <span>Heliofísica USACH</span>
          </span>
        </a>
        <nav class="nav" aria-label={t.navLabel}>
          <ul class="nav-links" id="nav-links">
            {navOrder.map((k) => (
              <li><a href={navHref(k)} data-nav={k} aria-current={activeNav === k ? 'true' : undefined}>{t.nav[k]}</a></li>
            ))}
          </ul>
          <div class="nav-tools">
            <a class="lang-switch" href={alt[otherLang]} hreflang={otherLang} lang={otherLang} title={t.otherLangName}>{t.otherLang}</a>
            <button id="theme-toggle" class="icon-btn theme-toggle" type="button" aria-label={t.themeToggle}>
              <svg class="icon-day" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
              <svg class="icon-night" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
            </button>
            <button id="menu-toggle" class="icon-btn menu-toggle" type="button" aria-label={t.menu} aria-controls="nav-links" aria-expanded="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
          </div>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-meta">
          <div>
            <h3>{t.footer.affiliations}</h3>
            <ul>
              {site.affiliations.map((a) => <li><a href={a.url} target="_blank" rel="noopener">{pick(a, 'name', lang)}</a></li>)}
            </ul>
          </div>
          <div>
            <h3>{t.footer.funding}</h3>
            <ul>{site.funders.map((f) => <li>{f}</li>)}</ul>
          </div>
          <div>
            <h3>{t.nav.contact}</h3>
            <ul>
              <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
              {site.social.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
            </ul>
          </div>
        </div>
        <p class="fine">© {new Date().getFullYear()} {site.name} · {pick(site.contact, 'address', lang)}</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = document.getElementById('theme-toggle');
        if (theme) {
          theme.setAttribute('aria-pressed', root.getAttribute('data-theme') === 'night' ? 'true' : 'false');
          theme.addEventListener('click', function () {
            var next = root.getAttribute('data-theme') === 'night' ? 'day' : 'night';
            root.setAttribute('data-theme', next);
            try { localStorage.setItem('theme', next); } catch (e) {}
            theme.setAttribute('aria-pressed', next === 'night' ? 'true' : 'false');
          });
        }
        var menu = document.getElementById('menu-toggle');
        var header = document.querySelector('.site-header');
        if (menu && header) {
          menu.addEventListener('click', function () {
            var open = header.getAttribute('data-open') === 'true';
            header.setAttribute('data-open', open ? 'false' : 'true');
            menu.setAttribute('aria-expanded', open ? 'false' : 'true');
          });
        }
        // Home page: highlight the nav item of the section in view.
        var spy = document.querySelectorAll('[data-section]');
        if (spy.length && 'IntersectionObserver' in window) {
          var links = document.querySelectorAll('.nav-links a[data-nav]');
          var so = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              var key = e.target.getAttribute('data-section');
              links.forEach(function (a) {
                if (a.getAttribute('data-nav') === key) a.setAttribute('aria-current', 'true');
                else a.removeAttribute('aria-current');
              });
            });
          }, { rootMargin: '-45% 0px -50% 0px' });
          spy.forEach(function (el) { so.observe(el); });
          if (header) header.querySelectorAll('.nav-links a').forEach(function (a) {
            a.addEventListener('click', function () { header.setAttribute('data-open', 'false'); if (menu) menu.setAttribute('aria-expanded', 'false'); });
          });
        }
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { els.forEach(function (el) { el.classList.add('in'); }); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.1 });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
