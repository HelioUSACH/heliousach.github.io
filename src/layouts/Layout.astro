---
import '../styles/global.css';
const lang = Astro.currentLocale === 'en' ? 'en' : 'es';
const { title, description, variant } = Astro.props;
// ES <-> EN page pairs (Spanish is the default locale, served without prefix).
const pagePairs = [
  ['/', '/en/'],
  ['/investigacion/', '/en/research/'],
  ['/equipo/', '/en/team/'],
  ['/laboratorio/', '/en/lab/'],
];
const site = 'https://heliousach.github.io';
const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const pair = pagePairs.find(([es, en]) => es === here || en === here) ?? ['/', '/en/'];
const p = (path_route) => lang === 'es' ? path_route : `/en${path_route}`;
// Nav links: on home page use in-page anchors; on sub-pages link to home page sections
const navLink = (hash) => variant === 'home' ? `#${hash}` : `${p('/')}#${hash}`;
// Open Graph image: 2019 La Silla eclipse (ESA/CESAR), also the homepage hero.
const ogImage = `${site}/images/eso1912u-la-silla-eclipse.jpg`;
const t = lang === 'en' ? {
  home: 'Home', research: 'Research', team: 'Team', lab: 'Infrastructure', contact: 'Contact',
  footer: `© ${new Date().getFullYear()} HelioFísica USACH.`,
  nav: 'Navigation',
  themeToggle: 'Toggle day/night theme',
  footerHeadline: 'Space weather research at USACH.',
  footerBody: 'We welcome collaborations, thesis projects, and press inquiries about heliophysics and space weather.',
  footerRole: 'Group co-lead',
  footerDept: 'Department of Physics',
  footerUniv: 'Universidad de Santiago de Chile',
} : {
  home: 'Inicio', research: 'Investigación', team: 'Equipo', lab: 'Infraestructura', contact: 'Contacto',
  footer: `© ${new Date().getFullYear()} HelioFísica USACH.`,
  nav: 'Navegación',
  themeToggle: 'Cambiar tema día/noche',
  footerHeadline: 'Investigación en clima espacial en USACH.',
  footerBody: 'Estamos abiertos a colaboraciones, memorias, tesis y consultas de prensa sobre heliofísica y clima espacial.',
  footerRole: 'Co-director del grupo',
  footerDept: 'Departamento de Física',
  footerUniv: 'Universidad de Santiago de Chile',
};
const canonicalUrl = `${site}${here}`;
const pageTitle = `${title} | Heliofísica USACH`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ResearchOrganization',
  name: 'Heliofísica y Clima Espacial USACH',
  url: 'https://heliousach.github.io',
  parentOrganization: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidad de Santiago de Chile (USACH)',
  },
  email: 'mailto:victor.pinto@usach.cl',
  sameAs: [
    'https://instagram.com/helio.usach',
    'https://twitter.com/vpintoa',
    'https://github.com/vpinto-space',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var saved = 'day';
        try { saved = localStorage.getItem('theme') || 'day'; } catch (e) {}
        document.documentElement.setAttribute('data-theme', saved);
        document.documentElement.classList.add('js');
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@400&family=Poppins:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Open Graph / Twitter Card -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Heliofísica USACH" />
    <meta property="og:locale" content={lang === 'en' ? 'en' : 'es_CL'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Bilingual hreflang -->
    <link rel="alternate" hreflang="es" href={`${site}${pair[0]}`} />
    <link rel="alternate" hreflang="en" href={`${site}${pair[1]}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${pair[0]}`} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body>
    <header>
      <nav>
        <a class="brand" href={p('/')} >
          <span>Heliof&#237;sica USACH</span>
        </a>
        <div class="nav-links">
          <a href={navLink('inicio')}>{t.home}</a>
          <a href={navLink('investigacion')}>{t.research}</a>
          <a href={navLink('equipo')}>{t.team}</a>
          <a href={navLink('laboratorio')}>{t.lab}</a>
          <a href={navLink('contacto')}>{t.contact}</a>
          {lang === 'es'
            ? <a class="lang-switch" href={pair[1]} hreflang="en" lang="en">EN</a>
            : <a class="lang-switch" href={pair[0]} hreflang="es" lang="es">ES</a>
          }
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label={t.themeToggle}
          >
            <svg class="icon-day" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            <svg class="icon-night" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
          </button>
        </div>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <div class="hp-wrap">
        <div class="hp-footer-grid">
          <div>
            <h2>{t.footerHeadline}</h2>
            <p>{t.footerBody}</p>
          </div>
          <div class="hp-contact-card">
            <p class="name">Dr. Victor A. Pinto</p>
            <p class="role">{t.footerRole}</p>
            <p class="dept">{t.footerDept}<br/>{t.footerUniv}</p>
            <a class="email" href="mailto:victor.pinto@usach.cl">victor.pinto@usach.cl</a>
            <div class="hp-social-row">
              <a href="https://instagram.com/helio.usach" target="_blank" rel="noopener">Instagram</a>
              <a href="https://twitter.com/vpintoa" target="_blank" rel="noopener">X / Twitter</a>
              <a href="https://github.com/vpinto-space" target="_blank" rel="noopener">GitHub</a>
            </div>
          </div>
        </div>
        <div class="hp-footer-bottom">
          <span class="fine">{t.footer}</span>
        </div>
      </div>
    </footer>
    <script is:inline>
      // Theme toggle
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var theme = document.documentElement.getAttribute('data-theme') || 'day';
        btn.setAttribute('aria-pressed', theme === 'night' ? 'true' : 'false');
        btn.addEventListener('click', function () {
          var next = document.documentElement.getAttribute('data-theme') === 'night' ? 'day' : 'night';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          btn.setAttribute('aria-pressed', next === 'night' ? 'true' : 'false');
        });
      })();
      // Scroll reveal (IntersectionObserver)
      (function () {
        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('.hp-reveal').forEach(function (el) { el.classList.add('in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.12 });
        document.querySelectorAll('.hp-reveal').forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>