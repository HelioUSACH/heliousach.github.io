---
import css from '../styles/global.css?inline';
const lang = Astro.currentLocale === 'en' ? 'en' : 'es';
const { title, description, variant } = Astro.props;
const p = (path_route) => lang === 'es' ? path_route : `/en${path_route}`;
const t = lang === 'en' ? {
  home: 'Home', research: 'Research', team: 'Team', lab: 'Lab', contact: 'Contact',
  footer: '© 2026 HelioFísica USACH. All rights reserved.',
  nav: 'Navigation',
  themeToggle: 'Toggle day/night theme',
  footerHeadline: "Let's talk space weather.",
  footerBody: 'We welcome collaborations, thesis projects, and press inquiries about heliophysics and space weather.',
  footerRole: 'Principal Investigator',
  footerDept: 'Department of Physics',
  footerUniv: 'Universidad de Santiago de Chile',
} : {
  home: 'Inicio', research: 'Investigación', team: 'Equipo', lab: 'Laboratorio', contact: 'Contacto',
  footer: '© 2026 HelioFísica USACH. Todos los derechos reservados.',
  nav: 'Navegación',
  themeToggle: 'Cambiar tema día/noche',
  footerHeadline: 'Conversemos sobre clima espacial.',
  footerBody: 'Estamos abiertos a colaboraciones, memorias, tesis y consultas de prensa sobre heliofísica y clima espacial.',
  footerRole: 'Investigador Principal',
  footerDept: 'Departamento de Física',
  footerUniv: 'Universidad de Santiago de Chile',
};
const canonicalPath = lang === 'en' ? '/en/' : '/';
const canonicalUrl = `https://heliousach.github.io${canonicalPath}`;
const pageTitle = `${title} | Heliofísica USACH`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ResearchOrganization',
  name: 'Heliofísica y Clima Espacial USACH',
  url: 'https://heliousach.github.io',
  parentOrganization: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidad de Santiago de Chile (USACH)',
  },
  email: 'mailto:victor.pinto@usach.cl',
  sameAs: [
    'https://instagram.com/helio.usach',
    'https://twitter.com/vpintoa',
    'https://github.com/vpinto-space',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('theme') || 'day';
        document.documentElement.setAttribute('data-theme', saved);
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Open Graph / Twitter Card -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Heliofísica USACH" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_CL'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body class={variant === 'home' ? 'hp-theme' : ''}>
    <header>
      <nav>
        <a class="brand" href={p('/')} >
          <span>Heliof&#237;sica USACH</span>
        </a>
        <div style="display:flex;gap:1.3rem;align-items:center;flex-wrap:wrap">
          <a href="#inicio">{t.home}</a>
          <a href="#investigacion">{t.research}</a>
          <a href="#equipo">{t.team}</a>
          <a href="#laboratorio">{t.lab}</a>
          <a href="#contacto">{t.contact}</a>
          <span style="margin-left:0.5rem">
            {lang === 'es'
              ? <a href="/en/" style="color:var(--aurora-green);font-weight:600">EN</a>
              : <a href="/" style="color:var(--aurora-green);font-weight:600">ES</a>
            }
          </span>
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-pressed="false"
            aria-label={t.themeToggle}
          >
            <svg class="icon-day" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            <svg class="icon-night" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
          </button>
        </div>
      </nav>
    </header>
    <main><slot /></main>
    <footer id="contacto">
      <div class="hp-wrap">
        <div class="hp-footer-grid">
          <div>
            <h2>{t.footerHeadline}</h2>
            <p>{t.footerBody}</p>
          </div>
          <div class="hp-contact-card">
            <p class="name">Dr. Victor A. Pinto</p>
            <p class="role">{t.footerRole}</p>
            <p class="dept">{t.footerDept}<br/>{t.footerUniv}</p>
            <a class="email" href="mailto:victor.pinto@usach.cl">victor.pinto@usach.cl</a>
            <div class="hp-social-row">
              <a href="https://instagram.com/helio.usach" target="_blank" rel="noopener">Instagram</a>
              <a href="https://twitter.com/vpintoa" target="_blank" rel="noopener">X / Twitter</a>
              <a href="https://github.com/vpinto-space" target="_blank" rel="noopener">GitHub</a>
            </div>
          </div>
        </div>
        <div class="hp-footer-bottom">
          <span class="fine">{t.footer}</span>
        </div>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var isNight = document.documentElement.getAttribute('data-theme') === 'night';
        btn.setAttribute('aria-pressed', String(isNight));
        btn.addEventListener('click', function () {
          var next = document.documentElement.getAttribute('data-theme') === 'night' ? 'day' : 'night';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
          btn.setAttribute('aria-pressed', String(next === 'night'));
        });
      })();
    </script>
  </body>
</html>